# Admin panel credentials. Login fails closed (HTTP 503) if any of these are unset.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Random secret used to HMAC-sign the admin session cookie.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# Turso LibSQL. Required in production - the app refuses to start on an in-memory DB.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Analytics (optional; each block is skipped when its ID is unset)
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

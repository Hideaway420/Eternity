{
  "name": "eternity-shop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "seed": "tsx src/db/seed.ts",
    "seed:premium": "tsx scripts/seedPremiumProducts.ts",
    "audit:categories": "tsx scripts/auditCategories.ts",
    "purge:reset": "tsx scripts/purgeAndResetTaxonomy.ts",
    "restore:premium": "tsx scripts/restorePremiumProducts.ts",
    "migrate:flags": "tsx scripts/migrateFeatureFlags.ts",
    "typecheck": "tsc --noEmit",
    "test:auth": "tsx scripts/test-auth.ts",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate"
  },
  "allowScripts": {
